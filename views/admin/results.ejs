<%- include('../partials/head') %>

<div class="admin-layout">
  <%- include('../partials/admin-nav') %>

  <main class="admin-main">
    <section class="admin-section glass auto-result-panel">
      <h1>AUTO Result</h1>

      <% if (autoMessage) { %>
        <div class="auto-result-message <%= autoMessage.type === 'error' ? 'is-error' : 'is-success' %>"><%= autoMessage.text %></div>
      <% } %>

      <form method="POST" action="/admin/results/auto-settings" class="auto-result-form">
        <label class="auto-result-switch">
          <input type="checkbox" name="enabled" value="1" <%= autoResultConfig && autoResultConfig.enabled ? 'checked' : '' %> />
          <span>AUTO Result ON</span>
        </label>

        <label>
          <span>URL Sumber Result</span>
          <input type="url" name="sourceUrl" value="<%= autoResultConfig && autoResultConfig.sourceUrl ? autoResultConfig.sourceUrl : 'https://kakaktogelgroup.com/' %>" required />
        </label>

        <label>
          <span>Interval Scan (detik)</span>
          <input type="number" min="10" max="3600" name="intervalSeconds" value="<%= autoResultConfig && autoResultConfig.intervalSeconds ? autoResultConfig.intervalSeconds : 20 %>" required />
        </label>

        <label>
          <span>Timeout (detik)</span>
          <input type="number" min="5" max="60" name="timeoutSeconds" value="<%= autoResultConfig && autoResultConfig.timeoutSeconds ? autoResultConfig.timeoutSeconds : 15 %>" required />
        </label>

        <button class="action-btn" type="submit">Simpan Pengaturan AUTO</button>
      </form>

      <div class="auto-result-actions">
        <form method="POST" action="/admin/results/scan">
          <button class="action-btn" type="submit">Scan Sekarang</button>
        </form>
      </div>

      <div class="auto-result-status">
        <div><strong>Status:</strong> <%= autoResultConfig && autoResultConfig.enabled ? 'ON' : 'OFF' %></div>
        <div><strong>Scan Terakhir:</strong> <%= autoResultState && autoResultState.lastScanAt ? autoResultState.lastScanAt : '-' %></div>
        <div><strong>Sukses Terakhir:</strong> <%= autoResultState && autoResultState.lastSuccessAt ? autoResultState.lastSuccessAt : '-' %></div>
        <div><strong>Result Sumber:</strong> <%= autoResultState && Number.isFinite(Number(autoResultState.lastFound)) ? autoResultState.lastFound : 0 %></div>
        <div><strong>Result Baru Disimpan:</strong> <%= autoResultState && Number.isFinite(Number(autoResultState.lastSaved)) ? autoResultState.lastSaved : 0 %></div>
        <% if (autoResultState && autoResultState.lastError) { %>
          <div class="auto-result-error"><strong>Error:</strong> <%= autoResultState.lastError %></div>
        <% } %>
      </div>

      <p class="auto-result-note">Parser hanya membaca result utama dari elemen pasaran + keluaran + tanggal. Angka 4/5 digit disimpan sebagai teks sehingga 0085 dan 0709 tidak kehilangan nol depan. Matching pasaran exact/alias, tanpa fuzzy match.</p>
    </section>

    <section class="admin-section glass">
      <h1>Result Pasaran</h1>

      <div class="result-admin-list">
        <% markets.forEach(function(market){ %>
          <div class="result-admin-row glass">
            <div class="result-admin-market">
              <img
                src="<%= market.logoUrl || 'https://dummyimage.com/80x40/111/fff&text=LOGO' %>"
                alt="<%= market.name %>"
                class="result-admin-logo"
              />
              <div class="result-admin-name"><%= market.name %></div>
            </div>

            <form method="POST" action="/admin/results" class="result-admin-form">
              <input type="hidden" name="slug" value="<%= market.slug %>" />

              <div class="result-admin-input">
                <input
                  type="text"
                  name="prize1"
                  maxlength="5"
                  placeholder="XXXX"
                  value="<%= market.currentResult && market.currentResult.prize1 ? market.currentResult.prize1 : '' %>"
                  required
                />
              </div>

              <div class="result-admin-date">
                <input
                  type="date"
                  name="date"
                  value="<%= market.currentResult && market.currentResult.date ? market.currentResult.date : today %>"
                  required
                />
              </div>

              <div class="result-admin-time">
                <input
                  type="text"
                  name="resultTime"
                  value="<%= market.currentResult && market.currentResult.resultTime ? market.currentResult.resultTime : (market.resultTime || '') %>"
                  placeholder="03:00"
                  required
                />
              </div>

              <div class="result-admin-action">
                <button class="action-btn" type="submit">Simpan Result</button>
              </div>
            </form>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="admin-section glass">
      <h2>History Result</h2>

      <div class="admin-table result-history-table">
        <table>
          <thead>
            <tr>
              <th>Pasaran</th>
              <th>Hari</th>
              <th>Tanggal</th>
              <th>Prize 1</th>
              <th>Jam</th>
            </tr>
          </thead>
          <tbody>
            <% if (allHistory && allHistory.length) { %>
              <% allHistory.forEach(function(item){ %>
                <tr>
                  <td>
                    <div class="history-market-cell">
                      <img
                        src="<%= item.marketLogoUrl || 'https://dummyimage.com/60x30/111/fff&text=LOGO' %>"
                        alt="<%= item.marketName %>"
                        class="history-market-logo"
                      />
                      <span><%= item.marketName %></span>
                    </div>
                  </td>
                  <td><%= item.dayName %></td>
                  <td><%= item.date %></td>
                  <td><strong><%= item.prize1 %></strong></td>
                  <td><%= item.resultTime %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5">Belum ada history.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</div>

<%- include('../partials/footer') %>
